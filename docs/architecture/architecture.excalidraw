      "updated": 1790697805065,
      "link": null,
      "locked": false,
      "text": "I want to publish this online, so that its\nalso compatible and viewed on my phone \n- also a feature to add notes that are\ndirectly synced to my desktop / online. \n- I want it to be minimal as well, just like a\nnote-taking app. it will just have one button.\nthe voice button so i can record what I say,\nand the other is a place to type my ideas,\nbut sync to laptop.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "I want to publish this online, so that its also compatible and viewed on my phone \n- also a feature to add notes that are directly synced to my desktop / online. \n- I want it to be minimal as well, just like a note-taking app. it will just have one button. the voice button so i can record what I say, and the other is a place to type my ideas, but sync to laptop.",
      "autoResize": false,
      "lineHeight": 1.25
    },
